{
  "name": "energetics-grader",
  "main": "backend/worker.mjs",
  "compatibility_date": "2026-11-26",
  "vars": {
    "PAGES_ORIGIN": "https://iuphysics.github.io"
  },
  "ratelimits": [
    {
      "name": "GRADE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    }
  ]
}
